# chatsift 生产环境变量模板。复制为 .env.production 并填真实值(.env.production 不进 git)。
# 服务器上建软链:ln -s .env.production .env
# 机密(密码/JWT)由 Chase 在服务器生成,绝不提交到仓库。
# 注意:不含 LLM key —— DeepSeek key 由各租户在后台写入 tenant_llm_config 表。

# MySQL
MYSQL_ROOT_PASSWORD=change_me_strong_root_password
MYSQL_DATABASE=chatsift
MYSQL_USER=chatsift
MYSQL_PASSWORD=change_me_strong_app_password

# 应用
# 生成强随机:openssl rand -hex 32
JWT_SECRET=change_me_random_64_hex
