# chatsift 生产 Nginx 配置示例(放服务器 /etc/nginx/conf.d/)。
# 复用老项目域名 admin.kongyuekeji.com(chat_rpa 废弃后指向 chatsift)。
# 证书复用现有(若用 certbot,路径按实际)。

server {
    listen 80;
    server_name admin.kongyuekeji.com;
    # 强制跳 HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name admin.kongyuekeji.com;

    ssl_certificate     /etc/letsencrypt/live/admin.kongyuekeji.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.kongyuekeji.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 4m;   # 与 server express.json limit(2mb)留余量

    # 后台 SPA + API 都由 chatsift-server(3100)托管(server 内已做 SPA fallback + /api 路由)
    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
