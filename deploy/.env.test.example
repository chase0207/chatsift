# chatsift test 环境变量模板。复制为 .env.test 填值(不进 git)。
# 用法:cd deploy && docker compose -f docker-compose.test.yml --env-file .env.test up -d
# JWT_SECRET 必须与 prod 不同,避免 token 互通。

MYSQL_ROOT_PASSWORD=change_me_test_root_password
MYSQL_DATABASE=chatsift_test
MYSQL_USER=chatsift_test
MYSQL_PASSWORD=change_me_test_app_password

# 与 prod 不同的随机值:openssl rand -hex 32
JWT_SECRET=change_me_DIFFERENT_from_prod
